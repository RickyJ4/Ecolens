# Large media goes through Git LFS. GitHub rejects any file over 100 MB and
# warns above 50 MB; the Pakistan documentary alone is 105 MB.
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text

# Normalise line endings so Windows and Unix contributors diff cleanly.
* text=auto

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.wasm binary
*.db binary
*.docx binary
