# ═══════════════════════════════════════════════════════════════════════
# EcoLens Cartographic Intelligence Engine
#
# Self-contained QGIS rendering container for professional map generation.
# Pulls the official QGIS image, layers in EcoLens cartographic engine,
# and exposes a simple HTTP endpoint for map generation.
#
# Build:   docker build -t ecolens-carto -f Dockerfile.cartographic .
# Test:    docker run --rm ecolens-carto python3 /app/test_qgis.py
# Run:     docker run -p 8080:8080 ecolens-carto
# ═══════════════════════════════════════════════════════════════════════

FROM qgis/qgis:release-3_34

ENV DEBIAN_FRONTEND=noninteractive \
    QT_QPA_PLATFORM=offscreen \
    QGIS_PREFIX_PATH=/usr \
    PYTHONDONTWRITEBYTECODE=1 \
    PORT=8080

# Fonts for professional cartographic typography
RUN apt-get update && apt-get install -y --no-install-recommends \
    fonts-noto \
    fonts-noto-cjk \
    fonts-liberation \
    fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Python dependencies (only what the cartographic engine needs)
RUN pip3 install --no-cache-dir \
    "matplotlib>=3.8.0" \
    "geopandas>=0.14.0" \
    "mapclassify>=2.6.0" \
    "shapely>=2.0.0" \
    "numpy<2" \
    requests \
    flask \
    "pillow>=10.0.0" \
    "scikit-learn>=1.3.0,<1.6"

# Copy ONLY the cartographic engine (no Firebase deps needed for standalone)
COPY cartographic/ /app/cartographic/

# Copy the standalone test + server scripts
COPY cartographic/docker_server.py /app/server.py
COPY cartographic/docker_test.py /app/test_qgis.py

# Verify PyQGIS works at build time
RUN python3 -c "\
from qgis.core import QgsApplication; \
app = QgsApplication([], False); \
app.setPrefixPath('/usr', True); \
app.initQgis(); \
print('PyQGIS OK: ' + str(app.prefixPath())); \
app.exitQgis()"

EXPOSE 8080

CMD ["python3", "/app/server.py"]
